{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "✨ Debug Main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/jens_jugs/main.py",
            "args": ["start", "--secret", "JensJugs/Api/Local/Dev", "--log-reset", "--debug"], 
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
              "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Debug Pytest - RelayServer",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_relay_server.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug Pytest - RuleEvaluator",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_rule_evaluator.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug Pytest - RuleExecutor",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_rule_executor.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
